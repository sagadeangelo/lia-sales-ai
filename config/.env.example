# ══════════════════════════════════════════════
# LIA SALES AI — Variables de entorno
# Copiar como .env y completar manualmente
# ══════════════════════════════════════════════

# ─── n8n ───────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=REEMPLAZAR_CON_CLAVE_SEGURA

# ─── Ollama / LM Studio ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:4b
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=500

# ─── Claude / Anthropic ────────────────────────
ANTHROPIC_API_KEY=REEMPLAZAR_CON_API_KEY
ANTHROPIC_MODEL=claude-sonnet

# ─── WhatsApp / Twilio ─────────────────────────
TWILIO_ACCOUNT_SID=REEMPLAZAR_CON_SID
TWILIO_AUTH_TOKEN=REEMPLAZAR_CON_TOKEN
TWILIO_WHATSAPP_NUMBER=REEMPLAZAR_CON_NUMERO
MIGUEL_WHATSAPP=REEMPLAZAR_CON_NUMERO

# ─── Email ─────────────────────────────────────
RESEND_API_KEY=REEMPLAZAR_CON_API_KEY
EMAIL_FROM=noreply@tusitio.com
EMAIL_FROM_NAME=LIA Sales AI
MIGUEL_EMAIL=correo@ejemplo.com

# ─── Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=REEMPLAZAR_CON_TOKEN
TELEGRAM_CHAT_ID=REEMPLAZAR_CON_CHAT_ID

# ─── Pagos ─────────────────────────────────────
PAYMENT_PROVIDER=mercadopago

# MercadoPago
MP_ACCESS_TOKEN=REEMPLAZAR_CON_ACCESS_TOKEN
MP_PUBLIC_KEY=REEMPLAZAR_CON_PUBLIC_KEY
MP_WEBHOOK_SECRET=REEMPLAZAR_CON_WEBHOOK

# Stripe
STRIPE_SECRET_KEY=REEMPLAZAR_CON_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REEMPLAZAR_CON_WEBHOOK

# ─── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── URLs ──────────────────────────────────────
SITE_URL=https://tusitio.com
SIMULADOR_URL=https://tusitio.com/simulador

# ─── Sistema ───────────────────────────────────
APPROVAL_TIMEOUT_HOURS=2
NURTURING_FALLBACK_HOURS=24
DEFAULT_GUIDE_PRICE=299